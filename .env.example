# ---- Required ----
# Postgres connection string (Supabase, Neon, RDS or local Postgres)
# Supabase on Vercel: use the Transaction pooler URI (port 6543) from Connect → Connection string
DATABASE_URL=postgres://missprint:missprint@localhost:5432/missprint

# Public URL of this app (used in proof-approval links sent to customers)
APP_URL=http://localhost:3000

# ---- Shops (multi-tenancy) ----
# Name of the platform, shown before anyone signs in. Each shop sets its own name & logo in Settings.
APP_NAME="Print Shop Command Center"
# New print shops can create an account at /signup. Set a code to require it, or disable sign-up.
SIGNUP_CODE=
SIGNUP_DISABLED=

# ---- Files ----
# local = store uploads on disk (dev / single server)
# supabase = Supabase Storage, private bucket (required on Vercel — its disk is read-only)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# For STORAGE_DRIVER=supabase (Supabase → Project Settings → API Keys). Server-only; never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=miss-print-files

# ---- Email ----
# console = print emails to the server log (dev). resend = send via Resend (needed for team invites,
# password resets, proofs, quotes and reminders to actually arrive). Also set APP_URL above.
EMAIL_PROVIDER=console
# The sending address (a domain verified with your provider). Each shop's name is used as the sender name,
# and replies go to the shop's own email from Settings → Company Profile.
EMAIL_FROM="Miss Print <orders@missprintusa.com>"
RESEND_API_KEY=

# ---- Accounting (future) ----
# none | quickbooks
ACCOUNTING_PROVIDER=none
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=

# ---- AI (future, off by default) ----
# none | anthropic
AI_PROVIDER=none
ANTHROPIC_API_KEY=

# ---- Seed ----
# Password given to all demo users by `npm run db:seed`
SEED_PASSWORD=missprint2026
